# Database Settings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shipflow"

# BetterAuth Settings
BETTER_AUTH_SECRET="some-random-32-character-secret-string-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI SDK Settings (Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key-here"

# GitHub Integration (Optional - Fallback Mock available)
GITHUB_TOKEN="your-github-personal-access-token"

# Razorpay Payments (Optional - Fallback Mock available)
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
GROQ_API_KEY="your-groq-api-key"
# BetterAuth OAuth Social Providers
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
