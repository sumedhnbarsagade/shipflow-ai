{
  "name": "shipflow-ai",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev:turbo": "turbo run dev",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "dev": "concurrently -n \"turbo,inngest\" -c \"blue,green\" \"pnpm dev:turbo\" \"pnpm dev:inngest\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
